{
  "name": "nemesis",
  "private": true,
  "description": "Monorepo nemesis (nom de code) : information voyageur pour le transport en commun en Côte d'Ivoire.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "build": "pnpm -r run build",
    "proto:lint": "buf lint packages/proto && buf format packages/proto --diff --exit-code"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.74.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
