# Variables de l'environnement de développement (docker-compose.yml).
# Copier en .env pour les modifier ; .env n'est jamais versionné.
NEMESIS_DB_PASSWORD=nemesis_dev
NEMESIS_DEV_PASSWORD=nemesis_dev
NEMESIS_DB_PORT=5432
NEMESIS_VALKEY_PORT=6379
NEMESIS_NATS_PORT=4222
NEMESIS_NATS_MONITOR_PORT=8222
NEMESIS_TILES_PORT=8080

# API (services/api), lancée hors de Docker
DATABASE_URL=postgres://nemesis_api_dev:nemesis_dev@127.0.0.1:5432/nemesis
PORT=3000
