{
  "$description": "Jetons de design de yafohi, choisis par le porteur le 2026-11-10. Source pour les jetons de l'appli en phase 1. Voir README.md.",
  "color": {
    "mangue": {
      "value": "#FFC21A",
      "role": "Marque, bouton Signaler, surfaces mises en avant. Texte posé dessus : encre."
    },
    "encre": { "value": "#16130F", "role": "Boutons principaux, texte principal." },
    "creme": { "value": "#FFF9EE", "role": "Fond de l'appli." },
    "sable": { "value": "#FFF2D9", "role": "Champs, cartes secondaires." },
    "mangue-douce": { "value": "#FFE9A8", "role": "Bulles, puces mises en avant." },
    "blanc": { "value": "#FFFFFF", "role": "Cartes, feuilles." },
    "terre": { "value": "#5E574C", "role": "Texte secondaire." },
    "trait": { "value": "#F0E3C8", "role": "Séparateurs, bordures." },
    "feuille": { "value": "#1F7A47", "role": "Fluide, confirmé, en direct." }
  },
  "affluence": {
    "fluide": { "value": "#1F7A47", "bars": 1 },
    "ca-remplit": { "value": "#A35A00", "bars": 2 },
    "ca-deborde": { "value": "#C2332B", "bars": 3 }
  },
  "mode": {
    "gbaka": { "value": "#13855A", "label": "Gbaka" },
    "woro": { "value": "#BF5A00", "label": "Wôrô-wôrô" },
    "bus": { "value": "#2B59C3", "label": "Bus" },
    "bateau": { "value": "#077B99", "label": "Bateau-bus" },
    "marche": { "value": "#6B655A", "label": "À pied" }
  },
  "font": {
    "titre": { "family": "Baloo 2", "weight": 800, "fallback": "system-ui, sans-serif" },
    "texte": { "family": "Nunito", "weights": [600, 700, 800], "fallback": "system-ui, sans-serif" }
  },
  "size": {
    "titre-ecran": 23,
    "titre-feuille": 20,
    "texte": 16,
    "texte-petit": 13,
