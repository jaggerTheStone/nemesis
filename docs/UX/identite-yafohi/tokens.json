  "map": {
    "terre": "#FBF6EC",
    "eau": "#A9DDD6",
    "vegetation": "#DDEDCB",
    "foret": "#CBE4B6",
    "voie-principale": "#FFF0C2",
    "voie-rapide": "#FFD27A",
    "rue": "#FFFFFF"
  }
