{
  "name": "@nemesis/openapi",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:openapi": "redocly lint openapi.yaml --config redocly.yaml",
    "types": "openapi-typescript openapi.yaml -o src/schema.ts",
    "types:check": "openapi-typescript openapi.yaml -o src/schema.ts --check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@redocly/cli": "^2.67.1",
    "openapi-typescript": "^7.13.0"
  }
}
